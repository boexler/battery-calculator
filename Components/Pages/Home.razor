@page "/"
@using System.Globalization
@inject CsvParserService CsvParser
@inject BatterySimulationService BatterySimulator
@inject AmortizationCalculatorService AmortizationCalculator
@inject VendorDetectionService VendorDetector

<PageTitle>PV Battery Amortization Calculator</PageTitle>

<ColumnMappingModal 
    Show="@showMappingModal" 
    Headers="@csvHeaders" 
    Mapping="@columnMapping"
    OnConfirm="@HandleMappingConfirmed"
    OnClose="@HandleMappingClosed" />

<div class="calculator-container">
    <h1>PV Battery Amortization Calculator</h1>
    <p class="subtitle">Berechnen Sie die Amortisationsdauer Ihres PV-Batteriespeichers</p>

    <EditForm Model="@config" OnValidSubmit="@HandleCalculate">
        <DataAnnotationsValidator />

        <div class="section">
            <h2>1. CSV-Datei hochladen</h2>
            <div class="upload-section">
                <InputFile OnChange="@HandleFileSelected" accept=".csv" id="file-upload" class="file-input-hidden" />
                <label for="file-upload" class="file-label">
                    <span class="file-button">📁 CSV-Datei auswählen</span>
                </label>
                @if (!string.IsNullOrEmpty(uploadedFileName))
                {
                    <div class="file-info">
                        <span class="file-name">✓ @uploadedFileName</span>
                        @if (energyData != null && energyData.Count > 0)
                        {
                            <span class="file-count">(@energyData.Count Tage geladen)</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(uploadError))
                {
                    <div class="error-message">@uploadError</div>
                }
            </div>
        </div>

        @if (energyData != null && energyData.Count > 0)
        {
            <div class="section">
                <h2>2. Wechselrichter und Batterie auswählen</h2>
                
                <VendorSelectionComponent 
                    AvailableVendors="@availableVendors"
                    SelectedVendor="@selectedVendor"
                    OnVendorSelected="@HandleVendorSelected" />

                @if (selectedVendor != null)
                {
                    <BatteryTabsComponent 
                        Batteries="@selectedVendor.Batteries"
                        SelectedBattery="@selectedBattery"
                        OnBatterySelected="@HandleBatterySelected"
                        OnBatteryRemoved="@HandleBatteryRemoved"
                        OnBatteryAdded="@HandleBatteryAdded" />
                }
            </div>
        }
        else
        {
            <div class="section">
                <h2>2. Batterie-Parameter</h2>
                <p class="info-text">Bitte laden Sie zuerst eine CSV-Datei hoch, um automatische Vendor-Erkennung zu nutzen.</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="battery-capacity">Speicherkapazität (kWh)</label>
                        <InputNumber @bind-Value="config.BatteryCapacity" id="battery-capacity" class="form-control" step="0.01" />
                        <ValidationMessage For="@(() => config.BatteryCapacity)" />
                    </div>

                    <div class="form-group">
                        <label for="charge-loss">Ladeverlust (%)</label>
                        <InputNumber @bind-Value="config.ChargeLossPercent" id="charge-loss" class="form-control" step="0.1" />
                        <ValidationMessage For="@(() => config.ChargeLossPercent)" />
                    </div>

                    <div class="form-group">
                        <label for="discharge-loss">Entladeverlust (%)</label>
                        <InputNumber @bind-Value="config.DischargeLossPercent" id="discharge-loss" class="form-control" step="0.1" />
                        <ValidationMessage For="@(() => config.DischargeLossPercent)" />
                    </div>
                </div>
            </div>
        }

        <div class="section">
            <h2>3. Energiepreise</h2>
            <div class="form-grid">
                <div class="form-group">
                    <label for="price-purchase">kWh-Preis Netzbezug (€)</label>
                    <InputNumber @bind-Value="config.PricePerKwhPurchase" id="price-purchase" class="form-control" step="0.001" />
                    <ValidationMessage For="@(() => config.PricePerKwhPurchase)" />
                </div>

                <div class="form-group">
                    <label for="price-feed">kWh-Preis Einspeisung (€)</label>
                    <InputNumber @bind-Value="config.PricePerKwhFeed" id="price-feed" class="form-control" step="0.001" />
                    <ValidationMessage For="@(() => config.PricePerKwhFeed)" />
                </div>

                <div class="form-group">
                    <label for="battery-price">Batteriepreis (€)</label>
                    <InputNumber @bind-Value="config.BatteryPrice" id="battery-price" class="form-control" step="0.01" disabled="@(selectedBattery != null && selectedBattery.Price.HasValue)" />
                    @if (selectedBattery != null && selectedBattery.Price.HasValue)
                    {
                        <small class="form-text">Wird von ausgewählter Batterie übernommen: @selectedBattery.Price.Value.ToString("F2") €</small>
                    }
                    <ValidationMessage For="@(() => config.BatteryPrice)" />
                </div>
            </div>
        </div>

        <div class="section">
            <button type="submit" class="btn-primary" disabled="@(energyData == null || energyData.Count == 0)">
                Berechnen
            </button>
        </div>
    </EditForm>

    @if (result != null)
    {
        <div class="section results-section">
            <h2>Ergebnisse</h2>

            <div class="results-grid">
                <div class="result-card @(result.IsAmortizationPossible ? "success" : "warning")">
                    <div class="result-label">Amortisationsdauer</div>
                    <div class="result-value">
                        @if (result.IsAmortizationPossible)
                        {
                            @if (result.AmortizationPeriodYears < 1)
                            {
                                <span>@result.AmortizationPeriodMonths.ToString("F1") Monate</span>
                            }
                            else
                            {
                                <span>@result.AmortizationPeriodYears.ToString("F1") Jahre</span>
                            }
                        }
                        else
                        {
                            <span>Nicht amortisierbar</span>
                        }
                    </div>
                </div>

                <div class="result-card">
                    <div class="result-label">Jährliche Einsparungen</div>
                    <div class="result-value">@result.AnnualSavings.ToString("F2") €</div>
                </div>

                <div class="result-card">
                    <div class="result-label">Gesamteinsparungen (Simulationszeitraum)</div>
                    <div class="result-value">@result.TotalSavings.ToString("F2") €</div>
                </div>

                <div class="result-card">
                    <div class="result-label">Simulationszeitraum</div>
                    <div class="result-value">@result.SimulationDays Tage</div>
                </div>
            </div>

            <div class="energy-metrics">
                <h3>Energiemetriken</h3>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <span class="metric-label">Energie gespart (durch Entladung):</span>
                        <span class="metric-value">@result.TotalEnergySaved.ToString("F2") kWh</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">Energie für Ladung verwendet:</span>
                        <span class="metric-value">@result.TotalEnergyUsedForCharging.ToString("F2") kWh</span>
                    </div>
                </div>
            </div>

            @if (result.DailyResults != null && result.DailyResults.Count > 0)
            {
                <div class="daily-results">
                    <h3>Tägliche Ergebnisse</h3>
                    <div class="daily-results-monthly">
                        <div class="month-expander-grid month-expander-grid-head" role="row">
                            <span class="month-expander-cell month-expander-head-first">Datum</span>
                            <span class="month-expander-cell month-expander-head-numeric">Akku Start (kWh)</span>
                            <span class="month-expander-cell month-expander-head-numeric">Entladen (kWh)</span>
                            <span class="month-expander-cell month-expander-head-numeric">Geladen (kWh)</span>
                            <span class="month-expander-cell month-expander-head-numeric">Akku Ende (kWh)</span>
                            <span class="month-expander-cell month-expander-head-numeric">Netzbezug ohne Akku (kWh)</span>
                            <span class="month-expander-cell month-expander-head-numeric">Netzbezug mit Akku (kWh)</span>
                            <span class="month-expander-cell month-expander-head-numeric">Einspeisung ohne Akku (kWh)</span>
                            <span class="month-expander-cell month-expander-head-numeric">Einspeisung mit Akku (kWh)</span>
                        </div>
                        @foreach (var monthGroup in GroupDailyResultsByMonth(result.DailyResults))
                        {
                            var sums = SumDailyColumns(monthGroup.Days);
                            <details class="month-expander">
                                <summary class="month-expander-grid month-expander-summary">
                                    <span class="month-expander-cell month-expander-month">@monthGroup.Month.ToString("MMMM yyyy", GermanCulture)</span>
                                    <span class="month-expander-cell">@($"{sums.BatteryChargeStartSum:F2} kWh")</span>
                                    <span class="month-expander-cell">@($"{sums.EnergyDischargedSum:F2} kWh")</span>
                                    <span class="month-expander-cell">@($"{sums.EnergyChargedSum:F2} kWh")</span>
                                    <span class="month-expander-cell">@($"{sums.BatteryChargeEndSum:F2} kWh")</span>
                                    <span class="month-expander-cell">@($"{sums.OriginalGridDrawSum:F2} kWh")</span>
                                    <span class="month-expander-cell">@($"{sums.GridDrawAfterBatterySum:F2} kWh")</span>
                                    <span class="month-expander-cell">@($"{sums.OriginalGridFeedSum:F2} kWh")</span>
                                    <span class="month-expander-cell">@($"{sums.GridFeedAfterBatterySum:F2} kWh")</span>
                                </summary>
                                <div class="table-container month-expander-table-wrap">
                                    <table class="results-table">
                                        <thead>
                                            <tr>
                                                <th>Datum</th>
                                                <th>Akku Start (kWh)</th>
                                                <th>Entladen (kWh)</th>
                                                <th>Geladen (kWh)</th>
                                                <th>Akku Ende (kWh)</th>
                                                <th>Netzbezug ohne Akku (kWh)</th>
                                                <th>Netzbezug mit Akku (kWh)</th>
                                                <th>Einspeisung ohne Akku (kWh)</th>
                                                <th>Einspeisung mit Akku (kWh)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var day in monthGroup.Days)
                                            {
                                                <tr>
                                                    <td>@day.Date.ToString("dd.MM.yyyy")</td>
                                                    <td>@day.BatteryChargeStart.ToString("F2")</td>
                                                    <td>@day.EnergyDischarged.ToString("F2")</td>
                                                    <td>@day.EnergyCharged.ToString("F2")</td>
                                                    <td>@day.BatteryChargeEnd.ToString("F2")</td>
                                                    <td>@day.OriginalGridDraw.ToString("F2")</td>
                                                    <td>@day.GridDrawAfterBattery.ToString("F2")</td>
                                                    <td>@day.OriginalGridFeed.ToString("F2")</td>
                                                    <td>@day.GridFeedAfterBattery.ToString("F2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (isCalculating)
    {
        <div class="loading-overlay">
            <div class="loading-spinner">Berechne...</div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo GermanCulture = CultureInfo.GetCultureInfo("de-DE");

    private ConfigurationModel config = new();
    private List<EnergyDataRecord>? energyData;
    private AmortizationResult? result;
    private string uploadedFileName = string.Empty;
    private string uploadError = string.Empty;
    private bool isCalculating = false;
    
    private bool showMappingModal = false;
    private List<string> csvHeaders = new();
    private ColumnMapping columnMapping = new();
    private IBrowserFile? selectedFile;

    private List<IVendor> availableVendors = new();
    private IVendor? selectedVendor;
    private IBattery? selectedBattery;

    protected override void OnInitialized()
    {
        availableVendors = VendorDetector.GetAllVendors();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = string.Empty;
        uploadedFileName = e.File.Name;
        selectedFile = e.File;
        energyData = null;

        try
        {
            // Read headers from CSV file
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB max
            csvHeaders = await CsvParser.ReadHeadersAsync(stream);
            
            // Create automatic mapping suggestion
            columnMapping = CsvParser.CreateAutoMapping(csvHeaders);
            
            // Show mapping modal
            showMappingModal = true;
        }
        catch (Exception ex)
        {
            uploadError = $"Fehler beim Laden der CSV-Datei: {ex.Message}";
            energyData = null;
            showMappingModal = false;
        }
    }

    private async Task HandleMappingConfirmed(ColumnMapping mapping)
    {
        if (selectedFile == null)
        {
            return;
        }

        try
        {
            // Parse CSV with the confirmed mapping
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            energyData = await CsvParser.ParseCsvAsync(stream, mapping);
            uploadError = string.Empty;

            // Detect vendor from CSV headers
            var detectedVendor = VendorDetector.DetectVendor(csvHeaders, uploadedFileName);
            selectedVendor = detectedVendor;
            
            // Select first battery if available
            if (selectedVendor.Batteries.Count > 0)
            {
                selectedBattery = selectedVendor.Batteries[0];
                UpdateConfigFromSelection();
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Fehler beim Parsen der CSV-Datei: {ex.Message}";
            energyData = null;
        }
    }

    private void HandleMappingClosed()
    {
        showMappingModal = false;
        if (energyData == null)
        {
            uploadedFileName = string.Empty;
            selectedFile = null;
        }
    }

    private void HandleVendorSelected(IVendor vendor)
    {
        selectedVendor = vendor;
        if (vendor.Batteries.Count > 0)
        {
            selectedBattery = vendor.Batteries[0];
        }
        else
        {
            selectedBattery = null;
        }
        UpdateConfigFromSelection();
    }

    private void HandleBatterySelected(IBattery battery)
    {
        selectedBattery = battery;
        UpdateConfigFromSelection();
    }

    private void HandleBatteryAdded(IBattery battery)
    {
        if (selectedVendor != null)
        {
            selectedVendor.Batteries.Add(battery);
            selectedBattery = battery;
            UpdateConfigFromSelection();
        }
    }

    private void HandleBatteryRemoved(IBattery battery)
    {
        if (selectedVendor != null && battery.IsCustom)
        {
            selectedVendor.Batteries.Remove(battery);
            if (selectedBattery == battery)
            {
                selectedBattery = selectedVendor.Batteries.FirstOrDefault();
            }
            UpdateConfigFromSelection();
        }
    }

    private void UpdateConfigFromSelection()
    {
        if (selectedVendor != null)
        {
            config.ChargeLossPercent = selectedVendor.ChargeLossPercent;
            config.DischargeLossPercent = selectedVendor.DischargeLossPercent;
        }

        if (selectedBattery != null)
        {
            config.BatteryCapacity = selectedBattery.CapacityWh / 1000.0; // Convert Wh to kWh
            if (selectedBattery.Price.HasValue)
            {
                config.BatteryPrice = selectedBattery.Price.Value;
            }
        }
    }

    private async Task HandleCalculate()
    {
        if (energyData == null || energyData.Count == 0)
        {
            return;
        }

        isCalculating = true;
        result = null;

        try
        {
            await Task.Run(() =>
            {
                // Use values from selection or manual input
                var batteryCapacity = selectedBattery != null 
                    ? selectedBattery.CapacityWh / 1000.0 
                    : config.BatteryCapacity;
                var chargeLoss = selectedVendor != null 
                    ? selectedVendor.ChargeLossPercent 
                    : config.ChargeLossPercent;
                var dischargeLoss = selectedVendor != null 
                    ? selectedVendor.DischargeLossPercent 
                    : config.DischargeLossPercent;

                // Simulate battery behavior
                var simulationResults = BatterySimulator.Simulate(
                    energyData,
                    batteryCapacity,
                    chargeLoss,
                    dischargeLoss);

                // Use battery price from selection or manual input
                var batteryPrice = selectedBattery?.Price ?? config.BatteryPrice;

                // Calculate amortization
                result = AmortizationCalculator.Calculate(
                    simulationResults,
                    energyData,
                    config.PricePerKwhPurchase,
                    config.PricePerKwhFeed,
                    batteryPrice);
            });
        }
        catch (Exception ex)
        {
            uploadError = $"Fehler bei der Berechnung: {ex.Message}";
        }
        finally
        {
            isCalculating = false;
        }
    }

    /// <summary>
    /// Groups daily simulation rows by calendar month (first day of month as key), ordered chronologically.
    /// </summary>
    private static IReadOnlyList<MonthlyDailyGroup> GroupDailyResultsByMonth(IEnumerable<BatterySimulationResult> dailyResults)
    {
        return dailyResults
            .GroupBy(d => new DateTime(d.Date.Year, d.Date.Month, 1))
            .OrderBy(g => g.Key)
            .Select(g => new MonthlyDailyGroup(g.Key, g.OrderBy(x => x.Date).ToList()))
            .ToList();
    }

    /// <summary>
    /// Sums the eight numeric result columns over all days in a month (for expander summary row).
    /// </summary>
    private static DailyColumnSums SumDailyColumns(IReadOnlyList<BatterySimulationResult> days)
    {
        return new DailyColumnSums(
            BatteryChargeStartSum: days.Sum(d => d.BatteryChargeStart),
            EnergyDischargedSum: days.Sum(d => d.EnergyDischarged),
            EnergyChargedSum: days.Sum(d => d.EnergyCharged),
            BatteryChargeEndSum: days.Sum(d => d.BatteryChargeEnd),
            OriginalGridDrawSum: days.Sum(d => d.OriginalGridDraw),
            GridDrawAfterBatterySum: days.Sum(d => d.GridDrawAfterBattery),
            OriginalGridFeedSum: days.Sum(d => d.OriginalGridFeed),
            GridFeedAfterBatterySum: days.Sum(d => d.GridFeedAfterBattery));
    }

    private sealed record MonthlyDailyGroup(DateTime Month, IReadOnlyList<BatterySimulationResult> Days);

    private sealed record DailyColumnSums(
        double BatteryChargeStartSum,
        double EnergyDischargedSum,
        double EnergyChargedSum,
        double BatteryChargeEndSum,
        double OriginalGridDrawSum,
        double GridDrawAfterBatterySum,
        double OriginalGridFeedSum,
        double GridFeedAfterBatterySum);

    public class ConfigurationModel
    {
        public double BatteryCapacity { get; set; } = 5.12;
        public double ChargeLossPercent { get; set; } = 5.0;
        public double DischargeLossPercent { get; set; } = 5.0;
        public double PricePerKwhPurchase { get; set; } = 0.30;
        public double PricePerKwhFeed { get; set; } = 0.08;
        public double BatteryPrice { get; set; } = 5000.0;
    }
}
